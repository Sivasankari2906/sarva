# Sarva OTP server settings. Never commit the real .env.
# Path to a Firebase service-account key, used only to verify users' ID tokens.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=your-project-id
# textbee (open-source Android SMS gateway): API key and optional device id from the textbee dashboard.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev
# Comma-separated web origins allowed to call the server (your Sarva site).
ALLOWED_ORIGINS=http://localhost:3000
# 127.0.0.1 for local use. On a hosting platform set HOST=0.0.0.0 behind its HTTPS front end.
HOST=127.0.0.1
PORT=8787
# Cap on SMS sent by this server per hour (all users together).
MAX_SMS_PER_HOUR=30
# Set to true to only allow users whose email address is verified in Firebase Auth.
REQUIRE_VERIFIED_EMAIL=false
