rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A user's own profile.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Documents and medicines belong to the user in the userId field.
    match /documents/{docId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    match /medicines/{medicineId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // Scheme catalogue: any signed-in user can read it. Only the Firebase console or
    // the Admin SDK can change it.
    match /schemes/{schemeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Per-user derived data.
    match /eligibility_cache/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /dependency_map/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
