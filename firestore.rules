rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A user's own profile.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // A document can only be marked verified if the OTP server recorded that this user
    // verified that phone number (phone_verifications is written only by the server).
    function verificationOk(data) {
      return data.get('verified', false) != true
        || (data.get('verifiedPhone', '') is string
            && exists(/databases/$(database)/documents/phone_verifications/$(request.auth.uid + '_' + data.verifiedPhone)));
    }

    // Documents and medicines belong to the user in the userId field.
    match /documents/{docId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && verificationOk(request.resource.data);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && verificationOk(request.resource.data);
    }

    match /phone_verifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /medicines/{medicineId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // Scheme catalogue: any signed-in user can read it. Only the Firebase console or
    // the Admin SDK can change it.
    match /schemes/{schemeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Per-user derived data.
    match /eligibility_cache/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /dependency_map/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
